# Database Configuration
DB_HOST=localhost
DB_NAME=farm_management
DB_USER=root
DB_PASS=

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-use-random-bytes

# Application Settings
APP_ENV=production
APP_DEBUG=false
